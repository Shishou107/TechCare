# TechCare — danh sach bien moi truong / user-secrets can co (FILE MAU, khong ghi gia tri that vao repo)
# May dev: dung `dotnet user-secrets set "TenBien" "gia-tri"` (csproj da co UserSecretsId)
# May chu: dat thanh bien moi truong cua he dieu hanh / dich vu chay API

# JWT (da co tu truoc — gia tri phai la secret MOI, chua tung lo)
TECHCARE_JWT_SECRET=

# AI chatbot (RAG) — khoa cua dich vu AI tuong thich OpenAI (Meta Model API / OpenAI / ...)
# De trong = chatbot chay che do tim kiem tu khoa du phong
TECHCARE_AI_API_KEY=

# GHN (Giao Hang Nhanh) — lay o Developer Portal cua GHN, moi truong staging truoc
TECHCARE_GHN_TOKEN=
TECHCARE_GHN_SHOP_ID=
# Secret tu dat de xac thuc webhook GHN goi ve (khong dung chung voi khoa khac)
TECHCARE_GHN_WEBHOOK_SECRET=
